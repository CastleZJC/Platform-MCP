# Platform-MCP 基础配置模板（dev 默认加载）
# 复制为 settings.yml 后修改为实际值；与 settings-{env}.yml 合并（后者覆盖前者）
#
# 路径一致性原则：
# - crypto-secret.key 放项目根（由 scripts/_setup_local.py 自动生成，gitignored）
# - 前端 build 产物在 platform-mcp-frontend/dist
app:
  name: Platform-MCP
  version: 0.1.0
  env: dev

server:
  host: "0.0.0.0"
  port: 8000
  workers: 1

database:
  # 替换 USER/PASSWORD/HOST 为你的 PostgreSQL 实际值
  url: "postgresql+asyncpg://pmcp:<password>@localhost:5432/platform_mcp"
  echo: false
  pool_size: 5
  max_overflow: 10

datasource:
  # Oracle Instant Client 目录（连接 Oracle 11g thick 模式必需）；不连 Oracle 留空字符串
  oracle_instant_client_dir: ""
  allowed_sql_dirs: []
  default_query_timeout: 300
  default_max_concurrent: 5
  max_file_size_mb: 10
  crypto_key_path: "crypto-secret.key"

mcp:
  transport: stdio

skill:
  upload_dir: uploads/skills
  max_upload_size_mb: 50
  # ── V3.0 M3：广场语义搜索向量栈（BGE-M3，架构 §19.5.6）──
  # 权重离线分发（VNF-03：不入仓库、不联网下载）；留空自动降级确定性哈希向量，搜索链路始终可用
  # embedding_backend: auto（探测 pgvector，不可用降级 jsonb）/ pgvector / jsonb
  embedding_backend: auto
  embedding_model_path: ""            # BGE-M3 ONNX 权重目录（离线介质分发后填入）
  embedding_model_name: "BAAI/bge-m3"
  # ── V3.0 M4：本地生成模型栈（Qwen3-4B GGUF，架构 §19.5.6）──
  # 权重离线分发（VNF-03）；留空自动模板兜底（generated_by=template），生成链路始终可用
  # 启用前先跑权重校验：python scripts/_init_llm_weights.py [--sha256 <expected>] [--probe]
  # 静态配置：加载期初始化 Provider，切换权重需重启进程（§19.5.2 静态/动态边界）
  llm_model_path: ""                  # Qwen3-4B-Instruct GGUF 文件路径（离线介质分发后填入）
  llm_model_name: "Qwen3-4B-Instruct-GGUF"
  llm_timeout_seconds: 60             # 单次生成超时（超时放弃本次，模板兜底）
  llm_max_tokens: 1024                # 单次生成最大 token
  llm_n_ctx: 8192                     # 上下文窗口（prompt + 输出）

notify:
  # ── V3.0 M5：邮件组提醒 outbox 发送侧调度（架构 §19.5.5）──
  # SMTP 连接参数（host/port/user/password/from）不在此处：经运行时配置中心 smtp.* 键
  # （Web 系统配置页维护，flush 时实时读取，免改配置重启；密码 AES-GCM 加密落库）
  # 生产 SMTP 服务器参数为部署前置依赖（用户提供，部署规范 §2.7）；未配置时 outbox 持续
  # 堆积待发、周期任务自动重试（F-38），不阻断业务。
  flush_interval_seconds: 30          # Web 进程周期 flush 间隔
  flush_batch_size: 20                # 每轮最多发送条数
  max_retry: 5                        # 单条最大重试次数（超过留 failed 不再重试）

log:
  level: INFO
  dir: logs
  rotation: "10 MB"
  retention: "30 days"
